# Copy to .env and fill in only the providers you intend to use.
# Never commit .env or real credentials.

# Provider selection: ollama (default) or openai
LLM_PROVIDER=ollama

# Connection and request timeouts, in seconds
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=120

# Local Ollama (one model loaded at a time on 8 GB RAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_BATCH_SIZE=8
EMBEDDING_PROVIDER=ollama

# Optional cloud provider for complex reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web search: demo uses labeled fixtures; tavily uses the Tavily Search API
WEB_SEARCH_PROVIDER=demo
TAVILY_API_KEY=

# Application settings
APP_ENV=development
SQLITE_PATH=./data/agentx.sqlite3
CHROMA_PERSIST_DIRECTORY=./data/chroma
